{
  "name": "paspesa",
  "private": true,
  "description": "Paspesa — mobile-money transaction simulator (monorepo)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --web",
    "backend": "npm run dev -w @paspesa/backend",
    "app": "npm run start -w @paspesa/mobile",
    "web": "npm run web -w @paspesa/mobile",
    "admin": "npm run admin -w @paspesa/backend --",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9",
    "expo": "^58.0.26"
  }
}
