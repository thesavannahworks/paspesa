# Copy to .env (git-ignored). Never commit real credentials.

# PORT=3000
# DATABASE_URL=postgres://user:password@localhost:5432/paspesa   # unset = embedded PostgreSQL in ./.data/pglite

# M-PESA STK Push via Safaricom Daraja (https://developer.safaricom.co.ke → create an app → keys)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://example.com/v1/payments/mpesa/callback
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline for a Till
# MPESA_PARTY_B=                                 # Till number when using CustomerBuyGoodsOnline

# ---------------------------------------------------------------------------
# Other STK Push providers — fill in any you want to try; several can be on at once.
# Purchases can name one ("provider": "kopokopo"), otherwise PAYMENT_PROVIDER (or the first configured) is used.
# PAYMENT_PROVIDER=mpesa-daraja        # mpesa-daraja | kopokopo | intasend | paystack | payhero

# Kopo Kopo (https://app.kopokopo.com → applications; sandbox at sandbox.kopokopo.com)
KOPOKOPO_ENV=sandbox
KOPOKOPO_CLIENT_ID=
KOPOKOPO_CLIENT_SECRET=
KOPOKOPO_TILL=                         # your Till, or the K-prefixed online payments account number
KOPOKOPO_CALLBACK_URL=https://example.com/v1/payments/kopokopo/callback

# IntaSend (keys from sandbox.intasend.com / payment.intasend.com → API keys)
INTASEND_ENV=sandbox
INTASEND_SECRET_KEY=

# Paystack (Kenya account; sk_test_... for test mode)
PAYSTACK_SECRET_KEY=
# PAYSTACK_EMAIL_DOMAIN=customers.paspesa.app   # Paystack requires an email; one is made from the phone number

# PayHero (app.payhero.co.ke → API Keys → Add new API Key → copy the "Basic Authorization token";
# channel ID from Payment Channels → My Payment Channels — a till, a paybill or your bank account).
# New developer accounts can ask PayHero support (WhatsApp) for up to KSh 300 of free test credits.
PAYHERO_BASIC_TOKEN=
# or, instead of the token: PAYHERO_API_USERNAME= and PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
# Optional: status is checked with PayHero anyway; a public URL only makes confirmation faster.
# PAYHERO_CALLBACK_URL=https://<your-backend>/v1/payments/payhero/callback

# ---------------------------------------------------------------------------
# Sign-in emails (6-digit codes). Without SMTP_HOST the codes are printed in the backend's console instead.
# Gmail: turn on 2-Step Verification, then Google account -> Security -> App passwords -> create one.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-character-app-password
# MAIL_FROM=Paspesa <you@gmail.com>

# Back office: require 2-step sign-in (authenticator app) for every admin. On by default when
# NODE_ENV=production; set true on any hosted server, false only to switch it off deliberately.
# ADMIN_REQUIRE_2FA=true
