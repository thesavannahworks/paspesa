# Production environment variables for Railway deployment
# Copy these variable names to Railway's environment variables section
# DO NOT commit actual secrets - this is just a template

# Server configuration
PORT=3000
HOST=0.0.0.0

# Database (from Neon - copy from your Neon project's connection string)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# PayHero payment provider (production credentials)
PAYHERO_BASIC_TOKEN=Basic <your-base64-encoded-credentials>
PAYHERO_CHANNEL_ID=<your-channel-id>
# PAYHERO_CALLBACK_URL will be: https://<your-railway-domain>.up.railway.app/v1/payments/payhero/callback

# Email for sign-in codes (choose ONE option)

# Option 1: Resend (Recommended - works on Railway)
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=Paspesa <onboarding@resend.dev>

# Option 2: Gmail SMTP (Blocked by Railway - use locally only)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=<your-email>@gmail.com
# SMTP_PASS=<your-gmail-app-password>
# MAIL_FROM=Paspesa <<your-email>@gmail.com>
