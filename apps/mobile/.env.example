# Copy to .env (git-ignored) to turn on backup/sync with the Paspesa backend.
# Use your computer's Wi-Fi address so the phone can reach it (find it with `ipconfig`), e.g.:
# EXPO_PUBLIC_PASPESA_API_URL=http://192.168.1.10:3000
# Leave it unset to keep the app fully offline.
EXPO_PUBLIC_PASPESA_API_URL=
