{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_PASPESA_API_URL": "https://paspesa-production.up.railway.app"
      },
      "channel": "preview",
      "autoIncrement": true
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_PASPESA_API_URL": "https://paspesa-production.up.railway.app"
      },
      "channel": "production",
      "autoIncrement": true
    }
  }
}
